---
interface Props {
  variant: "editorial" | "cinematic";
}
const { variant } = Astro.props;

const links = [
  { href: "#about", label: "About" },
  { href: "#stories", label: "Telling stories" },
  { href: "#exploring", label: "Exploring" },
  { href: "/DanzheChen2026.pdf", label: "Résumé" },
];
---

<header
  class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--bg)]/80 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="#top"
      class="font-display text-base font-semibold tracking-wide hover:text-[var(--accent)]"
    >
      Danzhe Chen
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hidden rounded-full px-3 py-1.5 text-sm text-[var(--muted)] transition-colors hover:bg-[var(--bg-alt)] hover:text-[var(--ink)] sm:inline-block"
          >
            {link.label}
          </a>
        ))
      }

      <!-- Compare switcher (temporary, for choosing a direction) -->
      <div class="ml-2 flex items-center rounded-full border border-[var(--line)] p-0.5 text-xs">
        <a
          href="/"
          class={`rounded-full px-3 py-1 transition-colors ${variant === "editorial" ? "bg-[var(--accent)] text-[var(--accent-ink)]" : "text-[var(--muted)] hover:text-[var(--ink)]"}`}
        >
          Light
        </a>
        <a
          href="/cinematic"
          class={`rounded-full px-3 py-1 transition-colors ${variant === "cinematic" ? "bg-[var(--accent)] text-[var(--accent-ink)]" : "text-[var(--muted)] hover:text-[var(--ink)]"}`}
        >
          Dark
        </a>
      </div>
    </div>
  </nav>
</header>
